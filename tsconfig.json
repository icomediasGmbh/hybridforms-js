{
    "include": [
        "src",
    ],
    "exclude": [
        "node_modules/**/*.ts"
    ],
    "compilerOptions": {
        "declaration": true,
        "declarationMap": false,
        "module": "NodeNext",
        "outDir": "dist/main",
        "rootDir": "src",
        "sourceMap": true,
        "target": "ES2015",
        "lib": [
            "es2022",
            "dom"
        ],
        "skipLibCheck": true,
        "strict": true,
        "esModuleInterop": true,
        "moduleResolution": "NodeNext",
        "forceConsistentCasingInFileNames": true,
        "stripInternal": true,
        "allowSyntheticDefaultImports": true,
        "types": [
            "node",
        ]
    }
}