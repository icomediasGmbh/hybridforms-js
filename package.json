{
    "name": "@icomedias/hybridforms-js",
    "description": "Isomorphic Javascript client for HybridForms",
    "version": "1.0.0",
    "scripts": {
        "build": "run-s clear prettier build:*",
        "build:main": "tsc -p tsconfig.json",
        "build:module": "tsc -p tsconfig.esm.json",
        "build:umd": "webpack --config webpack.config.js --mode=production && dts-bundle-generator --project tsconfig.umd.json -o dist/umd/hybridforms.d.ts src/index.ts --umd-module-name HybridFormsJS --no-check",
        "postbuild": "cd dist && zip -r ../dist.zip * && cd umd && zip -r ../../dist-umd.zip *",
        "clear": "rimraf dist/* && rimraf dist-umd.zip && rimraf dist.zip",
        "prettier": "prettier src --write",
        "lint": "eslint src test --fix",
        "test": "npm run lint && vitest run",
        "docs": "typedoc",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE.md"
    ],
    "main": "dist/main/index.js",
    "module": "dist/module/index.js",
    "types": "dist/module/index.d.ts",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.3.0",
        "@vitest/coverage-v8": "^4.1.11",
        "dts-bundle-generator": "^9.5.1",
        "eslint": "^10.9.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "prettier-plugin-organize-imports": "^4.3.0",
        "rimraf": "^6.1.3",
        "terser-webpack-plugin": "^5.6.1",
        "ts-loader": "^9.6.2",
        "ts-standard": "^12.0.2",
        "typedoc": "^0.28.20",
        "typedoc-github-theme": "^0.4.0",
        "typedoc-plugin-mdn-links": "^5.1.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.68.0",
        "vitest": "^4.1.11",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2"
    },
    "dependencies": {
        "jwt-decode": "^4.0.0",
        "node-fetch": "^3.3.2"
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "javascript",
        "typescript",
        "hybridforms"
    ],
    "engines": {
        "node": ">=18.0"
    },
    "author": {
        "name": "icomedias GmbH",
        "url": "https://icomedias.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/icomediasGmbh/hybridforms-js"
    },
    "homepage": "https://www.hybridforms.net",
    "bugs": "https://github.com/icomediasGmbh/hybridforms-js/issues"
}
